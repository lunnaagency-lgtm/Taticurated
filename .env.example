# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Add these same vars in Vercel too.
# The storefront runs with sample data until SANITY_PROJECT_ID is set, so you can
# build and preview the UI before any accounts exist.
# ─────────────────────────────────────────────────────────────────────────────

# Sanity (catalog / Tati's self-serve CMS) — read-only from the storefront.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Token with write access, used ONLY by the server webhook to flip items to "sold".
SANITY_WRITE_TOKEN=

# Stripe — hosted Checkout. Use test keys (sk_test_… / pk_test_…) until go-live.
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe webhook endpoint config. Verifies webhook authenticity.
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe coupon id for the bundle (10% off at 3+ items). When set it
# auto-applies at checkout; when blank, buyers type the BUNDLE10 code instead.
STRIPE_BUNDLE_COUPON_ID=
# Optional: set to "true" to turn on Stripe Tax at checkout, once the shop is
# registered for sales tax. Leave blank to keep tax off.
STRIPE_TAX_ENABLED=

# Public site origin, used to build Checkout success/cancel URLs.
# Locally this is http://localhost:4321 ; in production your real domain.
PUBLIC_SITE_URL=http://localhost:4321

# Optional: a Vercel Deploy Hook URL. When an item sells, the webhook pings this to
# rebuild the static store so the piece shows as sold. Leave blank to skip.
VERCEL_DEPLOY_HOOK_URL=

# Optional: forward captured emails (welcome 10% off) to any inbound webhook, e.g.
# Klaviyo / Mailchimp / Beehiiv, or Zapier / Make. Leave blank to just log in dev.
EMAIL_WEBHOOK_URL=
