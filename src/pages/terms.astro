---
import Base from '../layouts/Base.astro';
import { MARKETING, SITE } from '../config/brand';
---

<Base
  title="Terms draft"
  path="/terms"
  description={`Draft shopping terms for ${SITE.name}, including one of a kind inventory, final sales, pricing, discounts, and acceptable use.`}
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-16">
    <div class="rounded-panel border border-wine/10 bg-cream/80 px-6 py-10 shadow-panel sm:px-10 md:px-14 md:py-14">
      <p class="eyebrow">Policy draft</p>
      <h1 class="mt-4 font-display text-4xl leading-tight text-wine sm:text-5xl">Terms.</h1>
      <div class="mt-6 rounded-2xl border border-wine/15 bg-blush/45 p-4 text-sm leading-6 text-ink/80">
        This draft is not legal advice. Please review and adapt these terms.
      </div>

      <div class="mt-10 max-w-[68ch] space-y-9 text-base leading-8 text-ink/80">
        <section>
          <h2 class="font-display text-2xl text-ink">The pieces</h2>
          <p class="mt-3">
            {SITE.name} sells hand picked, secondhand pieces. Each piece is one of a kind, with only one
            available. A piece may become unavailable if another customer completes a purchase first.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Sales</h2>
          <p class="mt-3">
            All sales are final. Customers should review the listing description, condition, measurements,
            and photos before purchasing. Payment is processed through Stripe.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Pricing and discounts</h2>
          <p class="mt-3">
            Prices are shown in United States dollars. The welcome offer provides
            {MARKETING.welcomeDiscountPercent}% off a first order with the code {MARKETING.welcomeCode}.
            The bundle offer provides {MARKETING.bundle.discountPercent}% off when
            {MARKETING.bundle.minItems} pieces are purchased with the code {MARKETING.bundle.code}.
            The discount details shown in the store and at checkout apply to each offer.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Acceptable use</h2>
          <p class="mt-3">
            Customers may not misuse the site, interfere with its operation, attempt unauthorized access,
            use false payment or shipping information, or place fraudulent orders.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Contact</h2>
          <p class="mt-3">
            Questions about these terms can be sent to
            <a class="font-bold text-wine underline underline-offset-4" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
