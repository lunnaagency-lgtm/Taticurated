---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/brand';
---

<Base
  title="Thank you"
  path="/success"
  description={`Your ${SITE.name} order is confirmed. Find shipping timing and next steps after checkout.`}
  noindex={true}
>
  <section class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 md:py-24">
    <div class="relative overflow-hidden rounded-[2rem] bg-blush/55 px-6 py-16 md:px-14 md:py-20">
      <div class="absolute -left-32 -top-36 size-80 rounded-full border border-wine/10"></div>
      <div class="absolute -bottom-44 -right-28 size-96 rounded-full border border-wine/10"></div>
      <div class="relative">
        <p class="text-4xl" aria-hidden="true">♡</p>
        <p class="eyebrow mt-5">The find is yours</p>
        <h1 class="mt-4 font-display text-5xl text-wine md:text-6xl">Thank you. It’s officially yours.</h1>
        <p class="mx-auto mt-5 max-w-xl text-base leading-8 text-ink/80">
          Your order is confirmed and a receipt is on its way to your email. {SITE.name} ships in 1 to 3
          days. Since every piece is one of a kind, you just took home something no one else has.
        </p>
        <a href="/shop" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-wine px-7 text-sm font-bold text-cream transition hover:-translate-y-0.5 hover:bg-wine-deep">
          Keep browsing
        </a>
      </div>
    </div>
  </section>
</Base>
