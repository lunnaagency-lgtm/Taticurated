---
import Base from '../layouts/Base.astro';
import { SITE } from '../config/brand';
---

<Base
  title="Returns policy draft"
  path="/returns"
  description={`A draft returns policy for ${SITE.name}, including final sale terms and how to report an item that arrives not as described.`}
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-16">
    <div class="rounded-panel border border-brown/15 bg-ivory px-6 py-10 shadow-panel sm:px-10 md:px-14 md:py-14">
      <p class="eyebrow">Policy draft</p>
      <h1 class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl">Returns policy.</h1>
      <div class="mt-6 rounded-lg border border-brown/15 bg-blue/55 p-4 text-sm leading-6 text-brown">
        This draft is not legal advice. Please review and adapt these terms.
      </div>

      <div class="mt-10 max-w-[68ch] space-y-9 text-base leading-8 text-brown">
        <section>
          <h2 class="font-display text-2xl text-ink">All sales are final</h2>
          <p class="mt-3">
            Every piece is one of a kind and hand sourced for its material, construction, and condition. All sales are final.
            Customers should review the fabric, listing description, condition, measurements, and photos
            before purchasing.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">An item that arrives not as described</h2>
          <p class="mt-3">
            If an item arrives not as described in its listing, contact
            <a class="font-bold text-ink underline decoration-rose underline-offset-4" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
            as soon as possible. Include the order email, the item name, a description of the issue, and
            clear photos. The store will review the report and provide next steps.
          </p>
          <p class="mt-3">Do not send an item back unless return instructions are provided.</p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Contact</h2>
          <p class="mt-3">
            Questions about this returns draft can be sent to
            <a class="font-bold text-ink underline decoration-rose underline-offset-4" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
