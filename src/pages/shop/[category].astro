---
import Base from '../../layouts/Base.astro';
import ShopControls from '../../components/ShopControls.astro';
import { getProductsByCategory } from '../../lib/products';
import { CATEGORIES } from '../../lib/types';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { label: c.label } }));
}

const { category } = Astro.params;
const { label } = Astro.props as { label: string };
const products = await getProductsByCategory(category!);
---

<Base title={label} path={`/shop/${category}`} description={`${label} at Tati Curated. Hand sourced, previously loved pieces selected for fabric, construction, character, and lasting wear.`}>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">
    <div class="flex flex-col gap-4 border-b border-brown/15 pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">New pieces regularly</p>
        <h1 class="mt-3 font-display text-5xl tracking-[-0.03em] text-ink md:text-6xl">{label}.</h1>
        <p class="mt-4 max-w-xl text-sm leading-7 text-brown">
          Previously loved pieces, selected for material, construction, character, and lasting wear. Only one of each.
        </p>
      </div>
      <p class="text-sm font-bold text-ink">{products.length} unique pieces</p>
    </div>

    <nav aria-label="Shop categories" class="scroll-row mt-7 flex max-w-full gap-2 overflow-x-auto pb-2">
      <a href="/shop" class="inline-flex min-h-11 shrink-0 items-center rounded-md border border-brown/20 px-5 py-2.5 text-sm font-bold text-brown transition hover:border-brown hover:bg-paper hover:text-ink">All</a>
      {CATEGORIES.map((c) => (
        <a
          href={`/shop/${c.slug}`}
          aria-current={c.slug === category ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 shrink-0 items-center rounded-md px-5 py-2.5 text-sm font-bold transition',
            c.slug === category ? 'bg-ink text-ivory' : 'border border-brown/20 text-brown hover:border-brown hover:bg-paper hover:text-ink',
          ]}
        >
          {c.label}
        </a>
      ))}
    </nav>

    <div class="mt-10">
      <ShopControls products={products} />
    </div>
  </section>
</Base>
