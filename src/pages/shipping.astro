---
import Base from '../layouts/Base.astro';
import { COMMERCE, SITE } from '../config/brand';

const shippingRate = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: 0,
}).format(COMMERCE.shippingFlatRateCents / 100);
---

<Base
  title="Shipping policy draft"
  path="/shipping"
  description={`Shipping details for one of a kind natural fiber pieces from ${SITE.name}, including the flat rate, United States service area, 1 to 2 day handling time, and tracking.`}
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-16">
    <div class="rounded-panel border border-brown/15 bg-ivory px-6 py-10 shadow-panel sm:px-10 md:px-14 md:py-14">
      <p class="eyebrow">Policy draft</p>
      <h1 class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl">Shipping policy.</h1>
      <div class="mt-6 rounded-lg border border-brown/15 bg-blue/55 p-4 text-sm leading-6 text-brown">
        This draft is not legal advice. Please review and adapt these terms.
      </div>

      <div class="mt-10 max-w-[68ch] space-y-9 text-base leading-8 text-brown">
        <section>
          <h2 class="font-display text-2xl text-ink">Shipping rate</h2>
          <p class="mt-3">
            {SITE.name} charges a flat {shippingRate} shipping rate for each order.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Handling time</h2>
          <p class="mt-3">
            One of a kind pieces ship within 1 to 2 business days after payment is completed.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Where orders ship</h2>
          <p class="mt-3">
            Shipping is available within the United States.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Tracking</h2>
          <p class="mt-3">
            Tracking information is shared by email after the order ships. Customers should provide a
            complete and accurate shipping address at checkout.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Contact</h2>
          <p class="mt-3">
            Shipping questions can be sent to
            <a class="font-bold text-ink underline decoration-rose underline-offset-4" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
