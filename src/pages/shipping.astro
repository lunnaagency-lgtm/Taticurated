---
import Base from '../layouts/Base.astro';
import { COMMERCE, SITE } from '../config/brand';

const shippingRate = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: 0,
}).format(COMMERCE.shippingFlatRateCents / 100);
---

<Base
  title="Shipping policy draft"
  path="/shipping"
  description={`A draft shipping policy for ${SITE.name}, including the flat shipping rate, United States service area, handling time, and tracking.`}
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 md:py-16">
    <div class="rounded-[2rem] border border-wine/10 bg-cream/80 px-6 py-10 shadow-[0_18px_60px_rgba(81,24,36,0.06)] sm:px-10 md:px-14 md:py-14">
      <p class="eyebrow">Policy draft</p>
      <h1 class="mt-4 font-display text-4xl leading-tight text-wine sm:text-5xl">Shipping policy.</h1>
      <div class="mt-6 rounded-2xl border border-wine/15 bg-blush/45 p-4 text-sm leading-6 text-ink/80">
        This draft is not legal advice. Please review and adapt these terms.
      </div>

      <div class="mt-10 space-y-9 text-base leading-8 text-ink/80">
        <section>
          <h2 class="font-display text-2xl text-ink">Shipping rate</h2>
          <p class="mt-3">
            {SITE.name} charges a flat {shippingRate} shipping rate for each order.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Handling time</h2>
          <p class="mt-3">
            Orders ship within 1 to 3 days after payment is completed.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Where orders ship</h2>
          <p class="mt-3">
            Shipping is available within the United States.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Tracking</h2>
          <p class="mt-3">
            Tracking information is shared by email after the order ships. Customers should provide a
            complete and accurate shipping address at checkout.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-ink">Contact</h2>
          <p class="mt-3">
            Shipping questions can be sent to
            <a class="font-bold text-wine underline underline-offset-4" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
