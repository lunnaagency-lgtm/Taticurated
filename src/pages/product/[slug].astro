---
import Base from '../../layouts/Base.astro';
import BuyButton from '../../components/BuyButton.astro';
import { getAllProducts } from '../../lib/products';
import type { Product } from '../../lib/types';
import { formatPrice } from '../../lib/types';
import { SITE } from '../../config/brand';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };

const priceStr = (product.priceCents / 100).toFixed(2);
const availability =
  product.status === 'sold' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
  ...(product.colors.length ? { color: product.colors.join(', ') } : {}),
  ...(product.images.length ? { image: product.images.map((i) => i.url) } : {}),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: priceStr,
    availability,
    itemCondition: 'https://schema.org/UsedCondition',
    url: new URL(`/product/${product.slug}`, SITE.url).toString(),
    seller: { '@type': 'Organization', name: SITE.name },
  },
};

const details = [
  ['Brand', product.brand],
  ['Size', product.size],
  ['Condition', product.condition],
  ['Color', product.colors.join(', ') || null],
].filter(([, v]) => v) as [string, string][];
---

<Base
  title={product.title}
  path={`/product/${product.slug}`}
  description={product.description}
  image={product.images[0]?.url}
  jsonLd={[productSchema]}
>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-8 md:grid-cols-2 md:py-14">
    <!-- Gallery -->
    <div class="space-y-3">
      <div class="relative aspect-[4/5] overflow-hidden rounded-3xl bg-blush">
        {product.images[0] ? (
          <img src={product.images[0].url} alt={product.images[0].alt} class="h-full w-full object-cover" />
        ) : (
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blush to-blush-deep p-6 text-center">
            <span class="font-display text-2xl text-wine/70">{product.title}</span>
          </div>
        )}
        {product.status === 'sold' && (
          <div class="absolute inset-0 flex items-center justify-center bg-cream/70">
            <span class="rounded-full bg-ink px-5 py-1.5 text-sm font-semibold uppercase tracking-wide text-cream">Sold</span>
          </div>
        )}
      </div>
      {product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-3">
          {product.images.slice(1, 5).map((img) => (
            <div class="aspect-square overflow-hidden rounded-xl bg-blush">
              <img src={img.url} alt={img.alt} class="h-full w-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Details -->
    <div class="md:pt-4">
      {product.brand && <p class="text-xs uppercase tracking-[0.2em] text-wine/70">{product.brand}</p>}
      <h1 class="mt-2 font-display text-3xl text-ink md:text-4xl">{product.title}</h1>
      <p class="mt-3 text-2xl text-wine">{formatPrice(product.priceCents)}</p>

      <div class="mt-6">
        <BuyButton product={product} />
      </div>

      <p class="mt-3 text-center text-xs text-ink/50">
        Flat-rate shipping · Ships in 1 to 3 days · One of a kind, all sales final
      </p>

      {details.length > 0 && (
        <dl class="mt-8 divide-y divide-blush-deep/40 border-t border-blush-deep/40 text-sm">
          {details.map(([label, value]) => (
            <div class="flex justify-between py-3">
              <dt class="text-ink/60">{label}</dt>
              <dd class="font-medium text-ink">{value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="mt-8">
        <h2 class="font-display text-lg text-ink">Details</h2>
        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink/75">{product.description}</p>
      </div>
    </div>
  </section>
</Base>
