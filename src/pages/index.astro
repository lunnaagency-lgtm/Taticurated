---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getFeaturedProducts } from '../lib/products';
import { FAQ, faqSchema } from '../lib/faq';
import { SITE } from '../config/brand';

const featured = await getFeaturedProducts(8);
const homeFaq = [FAQ[0], FAQ[1], FAQ[3], FAQ[7], FAQ[9]];
---

<Base
  title="Natural fiber pieces for women and men"
  path="/"
  description="Tati Curated hand sources one of a kind cotton, linen, wool, and silk pieces for women and men. New drops daily, with quality made to last."
  jsonLd={[faqSchema(homeFaq)]}
>
  <section class="mx-auto max-w-7xl px-4 pb-12 pt-5 sm:px-6 md:pb-20 md:pt-8">
    <div class="relative overflow-hidden rounded-[2rem] border border-wine/10 bg-blush/40">
      <div class="grid min-h-[39rem] md:grid-cols-[1.12fr_0.88fr]">
        <div class="relative z-10 flex flex-col justify-center px-6 py-14 sm:px-10 md:px-14 lg:px-20">
          <p class="eyebrow">Natural fibers only. New drops daily.</p>
          <h1 class="mt-5 max-w-3xl font-display text-[2.75rem] leading-[1.02] text-wine sm:text-6xl lg:text-7xl">
            The missing piece to your next fit.
          </h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-ink/80 md:text-lg md:leading-8">
            They do not make them like this anymore. I hand source one of a kind cotton, linen, wool, and silk pieces for women and men, with quality meant to be worn for years.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/shop" class="inline-flex min-h-12 items-center justify-center rounded-full bg-wine px-7 text-sm font-bold text-cream shadow-[0_10px_30px_rgba(110,36,51,0.18)] transition hover:-translate-y-0.5 hover:bg-wine-deep">
              Shop the latest finds
            </a>
            <a href="/about" class="inline-flex min-h-12 items-center justify-center rounded-full border border-wine/25 px-7 text-sm font-bold text-wine transition hover:border-wine hover:bg-cream/70">
              Meet Tati’s point of view
            </a>
          </div>
          <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-xs font-bold uppercase tracking-[0.12em] text-wine/80">
            <span>Ships in 1 to 2 days</span>
            <span>Women and men</span>
            <span>Only one of each</span>
          </div>
        </div>

        <div class="relative min-h-[29rem] overflow-hidden bg-gradient-to-br from-blush via-cream to-blush-deep md:min-h-full">
          <div class="absolute -right-24 -top-24 size-80 rounded-full border border-wine/10"></div>
          <div class="absolute -bottom-32 -left-28 size-96 rounded-full border border-wine/10"></div>
          <div class="absolute inset-0 grid place-items-center p-8">
            <div class="editorial-frame relative aspect-[3/4] w-[76%] max-w-[23rem] rounded-[10rem_10rem_2rem_2rem] bg-cream/75 shadow-[0_24px_70px_rgba(81,24,36,0.15)]">
              <div class="absolute inset-0 z-10 flex flex-col items-center justify-center p-8 text-center">
                <span class="font-display text-7xl leading-none text-wine">C</span>
                <span class="mt-5 h-px w-16 bg-wine/35"></span>
                <span class="mt-5 text-[0.65rem] font-bold uppercase tracking-[0.28em] text-wine/85">The Tati edit</span>
                <p class="mt-4 font-display text-2xl italic leading-snug text-wine">Quality you can feel.</p>
              </div>
            </div>
          </div>
          <p class="absolute bottom-5 left-0 right-0 text-center text-[0.6rem] font-bold uppercase tracking-[0.25em] text-wine/85">
            Real product photos are coming soon
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20">
    <div class="mb-9 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">New drops daily</p>
        <h2 class="mt-3 font-display text-4xl text-ink md:text-5xl">Just in.</h2>
      </div>
      <a href="/shop" class="inline-flex min-h-11 shrink-0 items-center text-sm font-bold text-wine underline decoration-blush-deep decoration-2 underline-offset-4 hover:decoration-wine">
        See everything
      </a>
    </div>
    <ProductGrid products={featured} />
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20">
    <div class="grid overflow-hidden rounded-[2rem] bg-wine text-cream md:grid-cols-3">
      <div class="border-b border-cream/15 p-7 md:border-b-0 md:border-r md:p-10">
        <p class="font-display text-3xl">One means one.</p>
        <p class="mt-3 text-sm leading-7 text-cream/85">Every piece is individually sourced. Once it sells, it belongs in someone’s wardrobe.</p>
      </div>
      <div class="border-b border-cream/15 p-7 md:border-b-0 md:border-r md:p-10">
        <p class="font-display text-3xl">Natural fibers only.</p>
        <p class="mt-3 text-sm leading-7 text-cream/85">Cotton, linen, wool, and silk selected for feel, construction, and lasting quality.</p>
      </div>
      <div class="p-7 md:p-10">
        <p class="font-display text-3xl">For women and men.</p>
        <p class="mt-3 text-sm leading-7 text-cream/85">Timeless pieces for every wardrobe, each one ready to complete a new fit.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['Dresses', 'Silk, cotton, and linen silhouettes selected to last.', '/shop/dresses'],
        ['Shoes', 'One of a kind footwear, selected with the same careful eye.', '/shop/shoes'],
        ['Bags', 'The finishing piece that brings the whole fit together.', '/shop/bags'],
        ['The full edit', 'Women and men pieces, all in one place.', '/shop'],
      ].map(([name, copy, href], index) => (
        <a
          href={href}
          class:list={[
            'group flex min-h-64 flex-col justify-between overflow-hidden rounded-card border p-6 shadow-card transition hover:-translate-y-1 hover:shadow-card-hover',
            index % 2 === 0 ? 'border-wine/10 bg-blush/45' : 'border-wine/10 bg-cream',
          ]}
        >
          <span class="text-[0.62rem] font-bold uppercase tracking-[0.2em] text-wine/80">Shop the edit</span>
          <div>
            <h3 class="font-display text-3xl text-wine">{name}</h3>
            <p class="mt-2 text-sm leading-6 text-ink/80">{copy}</p>
            <span class="mt-5 inline-flex text-sm font-bold text-wine transition group-hover:translate-x-1" aria-hidden="true">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <Faq
    items={homeFaq}
    eyebrow="The details"
    title="Before you fall for a find."
    intro={`${SITE.name} keeps shopping simple, personal, and clear.`}
  />
</Base>
