---
import NewsletterForm from './NewsletterForm.astro';
import { SITE } from '../config/brand';
---

<footer id="footer" class="mt-20 border-t border-brown/15 bg-ivory">
  <div id="footer-newsletter" class="mx-auto max-w-7xl scroll-mt-36 px-4 py-14 sm:px-6 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div class="max-w-2xl">
        <p class="eyebrow">First access</p>
        <h2 class="mt-4 font-display text-4xl leading-[1.06] text-ink md:text-5xl">
          Receive 10% off your first order
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-7 text-brown">
          Join for first access to new drops, rare finds, and private edits.
        </p>
        <div class="mt-7">
          <NewsletterForm idPrefix="footer" buttonLabel="Send my 10% code" compact={true} />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 border-t border-brown/15 pt-8 sm:grid-cols-3 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
        <nav aria-label="Shop links" class="flex flex-col gap-1 text-sm">
          <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brown">Shop</p>
          <a href="/shop" class="footer-link">New arrivals</a>
          <a href="/shop/dresses" class="footer-link">Dresses</a>
          <a href="/shop/tops" class="footer-link">Tops</a>
          <a href="/shop/bottoms" class="footer-link">Bottoms</a>
        </nav>
        <nav aria-label="Brand links" class="flex flex-col gap-1 text-sm">
          <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brown">Tati</p>
          <a href="/about" class="footer-link">About</a>
          <a href="/faq" class="footer-link">FAQ</a>
          {SITE.email && <a href={`mailto:${SITE.email}`} class="footer-link">Contact</a>}
          {SITE.depop && <a href={SITE.depop} class="footer-link" rel="noopener noreferrer">Depop</a>}
          {SITE.instagram && <a href={SITE.instagram} class="footer-link" rel="noopener noreferrer">Instagram</a>}
        </nav>
        <nav aria-label="Policy links" class="col-span-2 flex flex-col gap-1 text-sm sm:col-span-1">
          <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-brown">Details</p>
          <a href="/shipping" class="footer-link">Shipping</a>
          <a href="/returns" class="footer-link">Returns</a>
          <a href="/privacy" class="footer-link">Privacy</a>
          <a href="/terms" class="footer-link">Terms</a>
        </nav>
      </div>
    </div>

    <div class="mt-16 grid gap-8 border-t border-brown/15 pt-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <a href="/" aria-label={`${SITE.name}, home`} class="inline-flex py-2">
          <img
            src="/logo.webp"
            alt="Tati Curated"
            width="1100"
            height="385"
            loading="lazy"
            decoding="async"
            class="h-auto w-[190px] sm:w-[220px]"
          />
        </a>
        <p class="mt-3 max-w-md text-sm leading-7 text-brown">
          Previously loved natural fiber clothing, thoughtfully sourced in Fort Lauderdale.
        </p>
      </div>
      <div class="text-xs leading-6 text-brown md:text-right">
        <p>© {new Date().getFullYear()} {SITE.name}.</p>
        <p>They don't make them like this no more.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    align-items: center;
    color: #574a45;
    display: inline-flex;
    min-height: 2.75rem;
    transition: color 180ms ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: #2f2a28;
  }
</style>
