---
import NewsletterForm from './NewsletterForm.astro';
import { MARKETING, SITE } from '../config/brand';
---

<footer id="footer" class="mt-20 border-t border-blush-deep/50 bg-blush/35">
  {MARKETING.bundle.enabled && (
    <a
      href="/shop"
      class="group block overflow-hidden bg-wine px-4 py-5 text-cream transition hover:bg-wine-deep"
    >
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-2 text-center sm:flex-row sm:gap-5">
        <span class="text-[0.65rem] font-bold uppercase tracking-[0.24em] text-blush">A sweeter trio</span>
        <span class="font-display text-xl sm:text-2xl">{MARKETING.bundle.message}</span>
        <span class="text-sm font-bold underline decoration-blush/50 underline-offset-4 group-hover:decoration-blush">
          Shop the edit
        </span>
      </div>
    </a>
  )}

  <div id="footer-newsletter" class="mx-auto max-w-7xl scroll-mt-32 px-4 py-14 sm:px-6 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-24">
      <div>
        <p class="eyebrow">First look access</p>
        <h2 class="mt-4 max-w-2xl font-display text-4xl leading-tight text-wine md:text-5xl">
          The best finds do not wait around.
        </h2>
        <p class="mt-4 max-w-xl text-sm leading-7 text-ink/80">
          Join for new daily drops, natural fiber finds, and {MARKETING.welcomeDiscountPercent}% off your first order.
        </p>
        <div class="mt-7">
          <NewsletterForm idPrefix="footer" buttonLabel="Join Tati’s list" compact={true} />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 border-t border-wine/15 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
        <nav aria-label="Shop links" class="flex flex-col gap-1 text-sm">
          <p class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-wine/80">Browse</p>
          <a href="/shop" class="inline-flex min-h-11 items-center transition hover:text-wine">Shop all</a>
          <a href="/shop/dresses" class="inline-flex min-h-11 items-center transition hover:text-wine">Dresses</a>
          <a href="/shop/shoes" class="inline-flex min-h-11 items-center transition hover:text-wine">Shoes</a>
          <a href="/shop/bags" class="inline-flex min-h-11 items-center transition hover:text-wine">Bags</a>
        </nav>
        <nav aria-label="Brand links" class="flex flex-col gap-1 text-sm">
          <p class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-wine/80">Tati</p>
          <a href="/about" class="inline-flex min-h-11 items-center transition hover:text-wine">Our story</a>
          <a href="/faq" class="inline-flex min-h-11 items-center transition hover:text-wine">FAQ</a>
          {SITE.email && <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center transition hover:text-wine">Contact</a>}
          {SITE.depop && <a href={SITE.depop} class="inline-flex min-h-11 items-center transition hover:text-wine" rel="noopener noreferrer">Depop</a>}
          {SITE.instagram && <a href={SITE.instagram} class="inline-flex min-h-11 items-center transition hover:text-wine" rel="noopener noreferrer">Instagram</a>}
        </nav>
        <nav aria-label="Policy links" class="col-span-2 border-t border-wine/15 pt-6">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-wine/80">Policies</p>
          <div class="flex flex-wrap gap-x-5 text-sm">
            <a href="/privacy" class="inline-flex min-h-11 items-center transition hover:text-wine">Privacy</a>
            <a href="/terms" class="inline-flex min-h-11 items-center transition hover:text-wine">Terms</a>
            <a href="/shipping" class="inline-flex min-h-11 items-center transition hover:text-wine">Shipping</a>
            <a href="/returns" class="inline-flex min-h-11 items-center transition hover:text-wine">Returns</a>
          </div>
        </nav>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-wine/15 pt-6 text-xs text-ink/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. The missing piece to your next fit.</p>
      <p>Natural fibers only. Women and men. New drops daily.</p>
    </div>
  </div>
</footer>
