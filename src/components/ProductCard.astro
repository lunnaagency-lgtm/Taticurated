---
import type { Product } from '../lib/types';
import { formatPrice } from '../lib/types';

interface Props {
  product: Product;
  createdIndex?: number;
}

const { product, createdIndex = 0 } = Astro.props;
const img = product.images[0];
const isSold = product.status === 'sold';
const isReserved = product.status === 'reserved';
const normalizeFacet = (value: string | null) => value?.trim().toLocaleLowerCase('en-US') ?? '';
const colorTokens = product.colors
  .map((color) => encodeURIComponent(normalizeFacet(color)))
  .filter(Boolean)
  .join(' ');
---

<a
  href={`/product/${product.slug}`}
  data-product-card
  data-size={normalizeFacet(product.size)}
  data-brand={normalizeFacet(product.brand)}
  data-condition={normalizeFacet(product.condition)}
  data-colors={colorTokens}
  data-category={normalizeFacet(product.category)}
  data-price={product.priceCents}
  data-status={product.status}
  data-created-index={createdIndex}
  class="group block focus-visible:rounded-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
>
  <div class="relative aspect-[4/5] overflow-hidden rounded-card border border-brown/10 bg-ivory transition duration-500 group-hover:-translate-y-1 group-hover:shadow-card-hover">
    {img ? (
      <img
        src={img.url}
        alt={img.alt}
        width={img.width}
        height={img.height}
        loading={createdIndex === 0 ? 'eager' : 'lazy'}
        fetchpriority={createdIndex === 0 ? 'high' : 'auto'}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025]"
      />
    ) : (
      <div class="editorial-frame flex h-full w-full items-center justify-center bg-ivory p-7 text-center">
        <div class="w-full">
          <span class="mx-auto block h-px w-12 bg-brown/35"></span>
          <span class="mt-6 block font-display text-2xl leading-snug text-ink">{product.title}</span>
          <span class="mx-auto mt-6 block h-px w-12 bg-brown/35"></span>
          <span class="mt-4 block text-[0.58rem] font-bold uppercase tracking-[0.2em] text-brown">The Tati edit</span>
        </div>
      </div>
    )}

    <span class="absolute left-3 top-3 z-10 rounded-md border border-brown/10 bg-ivory/95 px-2.5 py-1.5 text-[0.58rem] font-bold uppercase tracking-[0.14em] text-ink backdrop-blur">
      One of one
    </span>

    {isSold && (
      <div class="absolute inset-0 z-20 flex items-center justify-center bg-ivory/70 backdrop-blur-[1px]">
        <span class="rounded-md bg-ink px-5 py-2 text-xs font-bold uppercase tracking-[0.15em] text-ivory">
          Sold
        </span>
      </div>
    )}

    {isReserved && (
      <span class="absolute bottom-3 right-3 rounded-md bg-blue px-3 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-ink">
        On hold
      </span>
    )}
  </div>

  <div class="pt-4">
    {product.brand && <p class="text-[0.62rem] font-bold uppercase tracking-[0.16em] text-brown">{product.brand}</p>}
    <p class="mt-1 text-[0.95rem] font-medium leading-snug text-ink transition group-hover:text-brown">{product.title}</p>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-brown">
      <span class="font-bold text-ink">{formatPrice(product.priceCents)}</span>
      {product.size && <span>Size {product.size}</span>}
      {product.condition && <span>{product.condition}</span>}
    </div>
  </div>
</a>
