---
import type { Product } from '../lib/types';
import { formatPrice } from '../lib/types';

interface Props {
  product: Product;
  createdIndex?: number;
}

const { product, createdIndex = 0 } = Astro.props;
const img = product.images[0];
const isSold = product.status === 'sold';
const isReserved = product.status === 'reserved';
const pastelFields = ['bg-blush', 'bg-rose', 'bg-blue', 'bg-sage'];
const pastelField = pastelFields[createdIndex % pastelFields.length];
const normalizeFacet = (value: string | null) => value?.trim().toLocaleLowerCase('en-US') ?? '';
const colorTokens = product.colors
  .map((color) => encodeURIComponent(normalizeFacet(color)))
  .filter(Boolean)
  .join(' ');

const searchableCopy = `${product.title} ${product.description}`.toLocaleLowerCase('en-US');
const fibers = [
  ['cashmere', 'Cashmere'],
  ['linen', 'Linen'],
  ['silk', 'Silk'],
  ['wool', 'Wool'],
  ['cotton', 'Cotton'],
  ['leather', 'Leather'],
] as const;
const fitNotes = [
  ['relaxed', 'Relaxed fit'],
  ['bias cut', 'Bias cut'],
  ['straight leg', 'Straight leg'],
  ['high rise', 'High rise'],
  ['unisex', 'Unisex fit'],
  ['classic shape', 'Classic fit'],
  ['long line', 'Long line'],
] as const;
const fiber = fibers.find(([term]) => searchableCopy.includes(term))?.[1];
const fit = fitNotes.find(([term]) => searchableCopy.includes(term))?.[1];
const fallbackDetails = [product.brand, product.condition].filter(Boolean);
const editorialDetails = [fiber, fit].filter(Boolean) as string[];
fallbackDetails.forEach((detail) => {
  if (editorialDetails.length < 2 && detail && !editorialDetails.includes(detail)) {
    editorialDetails.push(detail);
  }
});
const subline = editorialDetails.join(' • ') || 'Previously loved • Condition reviewed';
---

<a
  href={`/product/${product.slug}`}
  data-product-card
  data-size={normalizeFacet(product.size)}
  data-brand={normalizeFacet(product.brand)}
  data-condition={normalizeFacet(product.condition)}
  data-colors={colorTokens}
  data-category={normalizeFacet(product.category)}
  data-price={product.priceCents}
  data-status={product.status}
  data-created-index={createdIndex}
  class="group block rounded-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
>
  <article class:list={['rounded-card p-3 transition duration-300 group-hover:-translate-y-1 group-hover:shadow-card-hover sm:p-4', pastelField]}>
    <div class="relative aspect-[4/5] overflow-hidden rounded-[0.55rem] border border-brown/10 bg-soft-white">
      {img ? (
        <img
          src={img.url}
          alt={img.alt}
          width={img.width}
          height={img.height}
          loading={createdIndex === 0 ? 'eager' : 'lazy'}
          fetchpriority={createdIndex === 0 ? 'high' : 'auto'}
          decoding="async"
          class:list={[
            'h-full w-full object-cover transition duration-700 ease-out group-hover:scale-[1.025]',
            isSold && 'saturate-[0.7]',
          ]}
        />
      ) : (
        <div class="editorial-frame flex h-full w-full items-center justify-center bg-soft-white p-6 text-center">
          <div class="w-full">
            <span class="mx-auto block h-px w-12 bg-brown/35"></span>
            <span class="mt-6 block font-display text-xl text-ink sm:text-2xl">{product.title}</span>
            <span class="mx-auto mt-6 block h-px w-12 bg-brown/35"></span>
            <span class="mt-4 block text-[0.58rem] font-bold uppercase tracking-[0.2em] text-brown">The Tati edit</span>
          </div>
        </div>
      )}

      {isSold && (
        <div class="absolute inset-0 z-20 flex items-end justify-center bg-ivory/45 p-4">
          <span class="bg-ivory/95 px-4 py-2 text-[0.65rem] font-bold uppercase tracking-[0.15em] text-ink">
            Sold
          </span>
        </div>
      )}

      {isReserved && (
        <span class="absolute bottom-3 right-3 bg-ivory/95 px-3 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-ink">
          On hold
        </span>
      )}
    </div>

    <div class="px-1 pb-1 pt-4">
      <h3 class="font-display text-xl text-ink sm:text-2xl">{product.title}</h3>
      <p class="mt-2 text-xs leading-[1.4] text-brown sm:text-sm">{subline}</p>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-ink/15 pt-3 text-sm">
        <span class="font-bold text-ink">{formatPrice(product.priceCents)}</span>
        {product.size && <span class="text-brown">Size {product.size}</span>}
      </div>
    </div>
  </article>
</a>
