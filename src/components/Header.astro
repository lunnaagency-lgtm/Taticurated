---
import { SITE } from '../config/brand';
import { CATEGORIES } from '../lib/types';
---

<header class="sticky top-0 z-40 border-b border-brown/15 bg-ivory/95 backdrop-blur-xl">
  <a
    href="/shop"
    class="flex min-h-9 items-center justify-center border-b border-brown/10 bg-paper px-4 py-2 text-center text-[0.66rem] font-bold uppercase leading-5 tracking-[0.16em] text-ink transition hover:bg-parchment"
  >
    Previously loved. Natural fibers first. New pieces added regularly.
  </a>

  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid min-h-24 grid-cols-[1fr_auto_1fr] items-center gap-3 lg:min-h-28">
      <nav aria-label="Main navigation" class="hidden items-center gap-7 lg:flex">
        <a href="/shop" class="nav-link font-bold">Shop</a>
        <a href="/shop" class="nav-link">The Edit</a>
        <a href="/about" class="nav-link">About</a>
      </nav>

      <button
        data-menu-button
        type="button"
        class="grid size-11 place-items-center justify-self-start rounded-lg border border-brown/20 text-ink transition hover:bg-paper lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
          <span class="h-px w-full bg-current transition"></span>
          <span class="h-px w-full bg-current transition"></span>
          <span class="h-px w-full bg-current transition"></span>
        </span>
      </button>

      <!-- Replace this wordmark span with /logo.svg or /logo.png when the final logo file is ready. -->
      <a
        href="/"
        aria-label={`${SITE.name}, home`}
        class="group col-start-2 flex min-h-16 min-w-0 flex-col items-center justify-center px-2 text-center text-ink"
      >
        <span class="font-display text-[1.75rem] font-medium leading-none tracking-[-0.04em] sm:text-[2.15rem]">
          Tati Curated
        </span>
        <span class="mt-2 flex items-center gap-2 text-[0.56rem] font-bold uppercase tracking-[0.3em] text-brown">
          <span class="h-px w-6 bg-brown/45 transition group-hover:w-8"></span>
          Shop
          <span class="h-px w-6 bg-brown/45 transition group-hover:w-8"></span>
        </span>
      </a>

      <div class="col-start-3 flex items-center justify-end gap-1 sm:gap-2">
        <a href="/faq" class="nav-link hidden lg:inline-flex">FAQ</a>
        <button
          data-cart-toggle
          type="button"
          class="relative grid size-11 place-items-center rounded-lg border border-brown/20 text-ink transition hover:bg-paper"
          aria-label="Open bag, 0 items"
        >
          <span class="sr-only">Bag</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-5">
            <path d="M6 8.5h12l-1 11.5H7L6 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M9 8.5V6.5a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span data-cart-count aria-hidden="true" class="absolute -right-1 -top-1 hidden min-w-5 rounded-full bg-ink px-1 text-center text-[0.65rem] font-bold leading-5 text-ivory">0</span>
        </button>
      </div>
    </div>

    <nav aria-label="Shop categories" class="scroll-row hidden max-w-full justify-center gap-8 overflow-x-auto border-t border-brown/10 py-3 lg:flex">
      {CATEGORIES.map((category) => (
        <a href={`/shop/${category.slug}`} class="whitespace-nowrap text-xs font-bold uppercase tracking-[0.14em] text-brown transition hover:text-ink">
          {category.label}
        </a>
      ))}
    </nav>
  </div>

  <div
    id="mobile-menu"
    data-mobile-menu
    class="absolute left-0 right-0 top-full hidden max-h-[calc(100vh-7rem)] overflow-y-auto border-t border-brown/15 bg-ivory shadow-panel lg:hidden"
  >
    <nav aria-label="Mobile navigation" class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
      <div class="grid gap-2">
        <a href="/shop" class="rounded-lg bg-ink px-5 py-4 font-display text-2xl text-ivory">
          Shop new arrivals
        </a>
        <a href="/shop" class="rounded-lg border border-brown/15 bg-soft-white px-5 py-4 font-bold text-ink">
          The Edit
        </a>
      </div>
      <p class="mt-6 text-[0.62rem] font-bold uppercase tracking-[0.18em] text-brown">Shop by category</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        {CATEGORIES.map((category, index) => (
          <a
            href={`/shop/${category.slug}`}
            class:list={[
              'rounded-lg border border-brown/15 px-4 py-3.5 text-sm font-bold text-ink transition hover:border-brown/35',
              index % 3 === 0 ? 'bg-blush/60' : index % 3 === 1 ? 'bg-blue/65' : 'bg-paper',
            ]}
          >
            {category.label}
          </a>
        ))}
      </div>
      <div class="mt-5 flex flex-wrap gap-x-6 border-t border-brown/15 pt-5 text-sm">
        <a href="/about" class="inline-flex min-h-11 items-center font-bold text-ink">About</a>
        <a href="/faq" class="inline-flex min-h-11 items-center font-bold text-ink">FAQ</a>
        {SITE.depop && <a href={SITE.depop} class="inline-flex min-h-11 items-center font-bold text-ink" rel="noopener noreferrer">Depop</a>}
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setMenu = (open: boolean, restoreFocus = false) => {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.classList.toggle('hidden', !open);
    if (!open && restoreFocus) menuButton.focus();
  };

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false, true);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setMenu(false);
  });

  window.addEventListener('menu:close', () => setMenu(false));
</script>

<style>
  .nav-link {
    align-items: center;
    color: #574a45;
    display: inline-flex;
    font-size: 0.8rem;
    min-height: 2.75rem;
    position: relative;
    transition: color 180ms ease;
  }

  .nav-link::after {
    background: #2f2a28;
    bottom: 0.45rem;
    content: '';
    height: 1px;
    left: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
    width: 100%;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #2f2a28;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
