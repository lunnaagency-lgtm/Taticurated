---
import { FAQ, type FaqItem } from '../lib/faq';

interface Props {
  items?: FaqItem[];
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  showAllLink?: boolean;
}

const {
  items = FAQ,
  eyebrow = 'A little more detail',
  title = 'Questions, answered.',
  intro = 'Everything to know before your favorite find becomes yours.',
  id = 'frequently-asked-questions',
  showAllLink = true,
} = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-32 px-4 py-16 md:py-24">
  <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
    <div class="lg:sticky lg:top-36 lg:self-start">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-4 max-w-md font-display text-4xl leading-tight text-wine md:text-5xl">
        {title}
      </h2>
      <p class="mt-5 max-w-sm text-base leading-relaxed text-ink/65">{intro}</p>
      {showAllLink && (
        <a
          href="/faq"
          class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-wine underline decoration-blush-deep decoration-2 underline-offset-4 transition hover:decoration-wine"
        >
          Visit the full FAQ
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="border-t border-wine/15">
      {items.map((item, index) => (
        <details class="faq-item group border-b border-wine/15" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left">
            <span class="font-display text-xl leading-snug text-ink md:text-2xl">{item.q}</span>
            <span
              class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-wine/20 text-lg text-wine transition group-open:rotate-45 group-open:bg-wine group-open:text-cream"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="max-w-2xl pb-7 pr-12 text-sm leading-7 text-ink/70 md:text-base">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
