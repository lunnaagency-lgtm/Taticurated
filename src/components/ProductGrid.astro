---
import type { Product } from '../lib/types';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  filterable?: boolean;
}
const { products, filterable = false } = Astro.props;
---

{products.length === 0 ? (
  <div class="rounded-panel border border-brown/15 bg-ivory px-6 py-16 text-center">
    <p class="font-display text-3xl text-ink">This edit is between finds.</p>
    <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-brown">
      Tati adds new, previously loved pieces regularly. Explore the full shop while this collection fills up.
    </p>
    <a href="/shop" class="mt-6 inline-flex rounded-lg bg-ink px-6 py-3 text-sm font-bold text-ivory transition hover:bg-brown">
      Shop every find
    </a>
  </div>
) : (
  <div
    data-product-grid={filterable ? '' : undefined}
    class:list={[
      'grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:gap-x-7 lg:gap-y-14',
      filterable ? 'xl:grid-cols-3' : 'md:grid-cols-3 lg:grid-cols-4',
    ]}
  >
    {products.map((product, index) => <ProductCard product={product} createdIndex={index} />)}
  </div>
)}
