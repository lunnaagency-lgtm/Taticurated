---
import type { Product } from '../lib/types';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
  filterable?: boolean;
}
const { products, filterable = false } = Astro.props;
---

{products.length === 0 ? (
  <div class="rounded-[2rem] border border-wine/10 bg-blush/35 px-6 py-16 text-center">
    <p class="font-display text-3xl text-wine">This edit is between finds.</p>
    <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-ink/80">
      Tati is always looking for the next one of a kind piece. Explore the full shop while this collection fills up.
    </p>
    <a href="/shop" class="mt-6 inline-flex rounded-full bg-wine px-6 py-3 text-sm font-bold text-cream transition hover:bg-wine-deep">
      Shop every find
    </a>
  </div>
) : (
  <div
    data-product-grid={filterable ? '' : undefined}
    class:list={[
      'grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:gap-x-6 lg:gap-y-14',
      filterable ? 'xl:grid-cols-3' : 'md:grid-cols-3 lg:grid-cols-4',
    ]}
  >
    {products.map((product, index) => <ProductCard product={product} createdIndex={index} />)}
  </div>
)}
