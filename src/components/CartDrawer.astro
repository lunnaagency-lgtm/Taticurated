---
import { MARKETING } from '../config/brand';
const { minItems, discountPercent } = MARKETING.bundle;
---

<div
  data-cart-drawer
  data-min={minItems}
  data-pct={discountPercent}
  class="fixed inset-0 z-[90] hidden"
  aria-hidden="true"
>
  <p data-cart-live class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  <div data-cart-overlay class="absolute inset-0 bg-ink/45 backdrop-blur-sm"></div>

  <aside
    data-cart-panel
    role="dialog"
    aria-modal="true"
    aria-label="Your bag"
    tabindex="-1"
    class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-ivory shadow-overlay transition-transform duration-300 ease-out"
  >
    <header class="flex items-center justify-between border-b border-brown/15 px-6 py-5">
      <h2 class="font-display text-2xl text-ink">Your bag</h2>
      <button
        data-cart-close
        type="button"
        class="grid size-11 place-items-center rounded-lg border border-brown/20 text-xl text-ink transition hover:bg-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        aria-label="Close bag"
      >
        ×
      </button>
    </header>

    <div data-cart-empty class="hidden flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
      <p class="font-display text-2xl text-ink">Your bag is empty.</p>
      <p class="text-sm text-brown">The good ones go once. Your next one of a kind find is waiting.</p>
      <a href="/shop" data-cart-close class="mt-2 inline-flex min-h-12 items-center rounded-lg bg-ink px-6 py-3 text-sm font-bold text-ivory transition hover:bg-brown">
        Shop the finds
      </a>
    </div>

    <ul data-cart-items class="flex-1 divide-y divide-brown/15 overflow-y-auto px-6"></ul>

    <footer data-cart-footer class="border-t border-brown/15 px-6 py-5">
      <div
        data-bundle-note
        class="mb-4 hidden rounded-lg border border-brown/15 bg-blue/60 px-4 py-3 text-sm font-medium text-ink"
      ></div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-brown">Subtotal</span>
        <span data-cart-subtotal class="font-display text-xl text-ink">$0</span>
      </div>
      <p class="mt-1 text-xs text-brown">Shipping and any discount codes are applied at checkout.</p>
      <button
        data-cart-checkout
        type="button"
        class="mt-4 w-full rounded-lg bg-ink px-6 py-4 text-base font-bold text-ivory transition hover:-translate-y-0.5 hover:bg-brown disabled:cursor-wait disabled:opacity-60"
      >
        Checkout
      </button>
      <p data-cart-error class="mt-2 hidden text-sm font-medium text-ink" role="alert"></p>
    </footer>
  </aside>
</div>

<script>
  import {
    getCart,
    removeFromCart,
    cartSubtotalCents,
    cartCount,
    pruneCart,
    onCartChange,
  } from '../lib/cart';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('[data-cart-panel]');
  const itemsEl = drawer?.querySelector<HTMLUListElement>('[data-cart-items]');
  const emptyEl = drawer?.querySelector<HTMLElement>('[data-cart-empty]');
  const footerEl = drawer?.querySelector<HTMLElement>('[data-cart-footer]');
  const subtotalEl = drawer?.querySelector<HTMLElement>('[data-cart-subtotal]');
  const bundleNoteEl = drawer?.querySelector<HTMLElement>('[data-bundle-note]');
  const checkoutBtn = drawer?.querySelector<HTMLButtonElement>('[data-cart-checkout]');
  const errorEl = drawer?.querySelector<HTMLElement>('[data-cart-error]');
  const closeBtn = drawer?.querySelector<HTMLButtonElement>('[data-cart-close]');
  const liveRegion = drawer?.querySelector<HTMLElement>('[data-cart-live]');
  let previousFocus: HTMLElement | null = null;
  let closeTimer: number | undefined;
  const backgroundState = new Map<HTMLElement, boolean>();

  const MIN = Number(drawer?.dataset.min) || 3;
  const PCT = Number(drawer?.dataset.pct) || 10;

  const money = (cents: number) =>
    (cents / 100).toLocaleString('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
    });

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));

  const bagCountLabel = (count: number) => `${count} ${count === 1 ? 'item' : 'items'} in bag`;

  const announce = (message: string) => {
    if (!liveRegion) return;
    liveRegion.textContent = '';
    window.requestAnimationFrame(() => {
      liveRegion.textContent = message;
    });
  };

  function updateCounts() {
    const count = cartCount();
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.classList.toggle('hidden', count === 0);
    });
    document.querySelectorAll<HTMLElement>('[data-cart-toggle]').forEach((button) => {
      button.setAttribute('aria-label', `Open bag, ${count} ${count === 1 ? 'item' : 'items'}`);
    });
  }

  function render() {
    if (!itemsEl || !emptyEl || !footerEl || !subtotalEl || !bundleNoteEl) return;
    const lines = getCart();

    const empty = lines.length === 0;
    emptyEl.classList.toggle('hidden', !empty);
    emptyEl.classList.toggle('flex', empty);
    itemsEl.classList.toggle('hidden', empty);
    footerEl.classList.toggle('hidden', empty);

    itemsEl.innerHTML = lines
      .map((l) => {
        const media = l.image
          ? `<img src="${escapeHtml(l.image)}" alt="" width="80" height="96" loading="lazy" decoding="async" class="h-full w-full object-cover" />`
          : `<div class="flex h-full w-full items-center justify-center bg-paper p-2 text-center"><span class="font-display text-xs leading-tight text-ink">${escapeHtml(l.title)}</span></div>`;
        const size = l.size ? `<span class="text-xs text-brown">Size ${escapeHtml(l.size)}</span>` : '';
        return `<li class="flex gap-4 py-4">
          <a href="/product/${encodeURIComponent(l.slug)}" aria-label="View ${escapeHtml(l.title)}" class="h-24 w-20 shrink-0 overflow-hidden rounded-md bg-ivory">${media}</a>
          <div class="flex flex-1 flex-col">
            <a href="/product/${encodeURIComponent(l.slug)}" class="inline-flex min-h-11 items-center font-display text-lg leading-snug text-ink hover:text-brown">${escapeHtml(l.title)}</a>
            ${size}
            <div class="mt-auto flex items-center justify-between">
              <span class="font-bold text-ink">${money(l.priceCents)}</span>
              <button data-remove="${escapeHtml(l.slug)}" type="button" aria-label="Remove ${escapeHtml(l.title)} from bag" class="inline-flex min-h-11 min-w-11 items-center justify-center text-xs text-brown underline underline-offset-4 transition hover:text-ink">Remove</button>
            </div>
          </div>
        </li>`;
      })
      .join('');

    subtotalEl.textContent = money(cartSubtotalCents());

    const n = lines.length;
    if (n >= MIN) {
      bundleNoteEl.textContent = `Bundle unlocked. ${PCT}% off is applied at checkout.`;
      bundleNoteEl.classList.remove('hidden');
    } else if (n > 0) {
      const more = MIN - n;
      bundleNoteEl.textContent = `Add ${more} more ${more === 1 ? 'piece' : 'pieces'} to get ${PCT}% off your order.`;
      bundleNoteEl.classList.remove('hidden');
    } else {
      bundleNoteEl.classList.add('hidden');
    }

    updateCounts();
  }

  const setBackgroundInert = (inert: boolean) => {
    if (!drawer) return;
    if (inert) {
      backgroundState.clear();
      Array.from(document.body.children).forEach((element) => {
        if (!(element instanceof HTMLElement) || element === drawer || element.tagName === 'SCRIPT') return;
        backgroundState.set(element, element.hasAttribute('inert'));
        element.setAttribute('inert', '');
      });
      return;
    }

    backgroundState.forEach((wasInert, element) => {
      if (!wasInert) element.removeAttribute('inert');
    });
    backgroundState.clear();
  };

  const focusableElements = () => {
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((element) => !element.closest('.hidden, [hidden], [aria-hidden="true"]') && element.getClientRects().length > 0);
  };

  const open = () => {
    if (!drawer || !panel) return;
    const wasOpen = !drawer.classList.contains('hidden');
    if (!wasOpen) {
      previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      setBackgroundInert(true);
    }
    if (closeTimer) window.clearTimeout(closeTimer);
    window.dispatchEvent(new CustomEvent('menu:close'));
    render();
    drawer.classList.remove('hidden');
    drawer.setAttribute('aria-hidden', 'false');
    window.requestAnimationFrame(() => {
      panel.classList.remove('translate-x-full');
      if (!wasOpen) closeBtn?.focus();
    });
    document.body.classList.add('overflow-hidden');
  };

  const close = () => {
    if (!drawer || !panel || drawer.classList.contains('hidden')) return;
    panel.classList.add('translate-x-full');
    closeTimer = window.setTimeout(() => {
      drawer.classList.add('hidden');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('overflow-hidden');
      setBackgroundInert(false);
      previousFocus?.focus();
      previousFocus = null;
    }, 300);
  };

  // Header bag buttons open the drawer.
  document.querySelectorAll<HTMLElement>('[data-cart-toggle]').forEach((b) =>
    b.addEventListener('click', open),
  );
  window.addEventListener('cart:open', open);

  drawer?.querySelectorAll<HTMLElement>('[data-cart-close]').forEach((b) =>
    b.addEventListener('click', close),
  );
  drawer?.querySelector('[data-cart-overlay]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (!drawer || drawer.classList.contains('hidden')) return;
    if (e.key === 'Escape') {
      close();
      return;
    }
    if (e.key !== 'Tab' || !panel) return;

    const focusable = focusableElements();
    if (!focusable.length) {
      e.preventDefault();
      panel.focus();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (!panel.contains(document.activeElement)) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
    } else if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  itemsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]');
    if (btn?.dataset.remove) {
      const removed = getCart().find((line) => line.slug === btn.dataset.remove);
      removeFromCart(btn.dataset.remove);
      render();
      announce(`Removed ${removed?.title ?? 'item'} from bag. ${bagCountLabel(cartCount())}.`);
    }
  });

  window.addEventListener('cart:announce', ((event: CustomEvent<{ message?: string }>) => {
    if (event.detail.message) announce(event.detail.message);
  }) as EventListener);

  checkoutBtn?.addEventListener('click', async () => {
    const slugs = getCart().map((l) => l.slug);
    if (!slugs.length || !errorEl) return;
    checkoutBtn.disabled = true;
    const label = checkoutBtn.textContent;
    checkoutBtn.textContent = 'Taking you to checkout...';
    errorEl.classList.add('hidden');
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slugs }),
      });
      const data = await res.json();
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      if (res.status === 409 && Array.isArray(data.unavailable)) {
        pruneCart(data.unavailable);
        render();
        throw new Error('Some pieces just sold and were removed from your bag.');
      }
      throw new Error(data.error || 'Something went wrong. Please try again.');
    } catch (err) {
      errorEl.textContent = (err as Error).message;
      errorEl.classList.remove('hidden');
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = label;
    }
  });

  onCartChange(render);
  updateCounts();
</script>
