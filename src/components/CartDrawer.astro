---
import { MARKETING } from '../config/brand';
const { minItems, discountPercent } = MARKETING.bundle;
---

<div data-cart-drawer data-min={minItems} data-pct={discountPercent} class="fixed inset-0 z-[90] hidden">
  <div data-cart-overlay class="absolute inset-0 bg-ink/45 backdrop-blur-sm"></div>

  <aside
    data-cart-panel
    role="dialog"
    aria-modal="true"
    aria-label="Your bag"
    class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-cream shadow-[0_24px_80px_rgba(81,24,36,0.28)] transition-transform duration-300 ease-out"
  >
    <header class="flex items-center justify-between border-b border-wine/10 px-6 py-5">
      <h2 class="font-display text-2xl text-wine">Your bag</h2>
      <button
        data-cart-close
        type="button"
        class="grid size-10 place-items-center rounded-full border border-wine/15 text-xl text-wine transition hover:bg-blush focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wine"
        aria-label="Close bag"
      >
        ×
      </button>
    </header>

    <div data-cart-empty class="hidden flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
      <p class="font-display text-2xl text-wine">Your bag is empty.</p>
      <p class="text-sm text-ink/60">Every piece is one of a kind. When you find one you love, add it here.</p>
      <a href="/shop" data-cart-close class="mt-2 rounded-full bg-wine px-6 py-3 text-sm font-bold text-cream transition hover:bg-wine-deep">
        Shop the finds
      </a>
    </div>

    <ul data-cart-items class="flex-1 divide-y divide-wine/10 overflow-y-auto px-6"></ul>

    <footer data-cart-footer class="border-t border-wine/10 px-6 py-5">
      <div
        data-bundle-note
        class="mb-4 hidden rounded-2xl border border-wine/15 bg-blush/50 px-4 py-3 text-sm font-medium text-wine"
      ></div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-ink/65">Subtotal</span>
        <span data-cart-subtotal class="font-display text-xl text-wine">$0</span>
      </div>
      <p class="mt-1 text-xs text-ink/50">Shipping and any discount codes are applied at checkout.</p>
      <button
        data-cart-checkout
        type="button"
        class="mt-4 w-full rounded-full bg-wine px-6 py-4 text-base font-bold text-cream transition hover:-translate-y-0.5 hover:bg-wine-deep disabled:cursor-wait disabled:opacity-60"
      >
        Checkout
      </button>
      <p data-cart-error class="mt-2 hidden text-sm text-wine" role="alert"></p>
    </footer>
  </aside>
</div>

<script>
  import {
    getCart,
    removeFromCart,
    cartSubtotalCents,
    cartCount,
    pruneCart,
    onCartChange,
  } from '../lib/cart';

  const drawer = document.querySelector<HTMLElement>('[data-cart-drawer]');
  const panel = drawer?.querySelector<HTMLElement>('[data-cart-panel]');
  const itemsEl = drawer?.querySelector<HTMLUListElement>('[data-cart-items]');
  const emptyEl = drawer?.querySelector<HTMLElement>('[data-cart-empty]');
  const footerEl = drawer?.querySelector<HTMLElement>('[data-cart-footer]');
  const subtotalEl = drawer?.querySelector<HTMLElement>('[data-cart-subtotal]');
  const bundleNoteEl = drawer?.querySelector<HTMLElement>('[data-bundle-note]');
  const checkoutBtn = drawer?.querySelector<HTMLButtonElement>('[data-cart-checkout]');
  const errorEl = drawer?.querySelector<HTMLElement>('[data-cart-error]');

  const MIN = Number(drawer?.dataset.min) || 3;
  const PCT = Number(drawer?.dataset.pct) || 10;

  const money = (cents: number) =>
    (cents / 100).toLocaleString('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
    });

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));

  function updateCounts() {
    const count = cartCount();
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.classList.toggle('hidden', count === 0);
    });
  }

  function render() {
    if (!itemsEl || !emptyEl || !footerEl || !subtotalEl || !bundleNoteEl) return;
    const lines = getCart();

    const empty = lines.length === 0;
    emptyEl.classList.toggle('hidden', !empty);
    emptyEl.classList.toggle('flex', empty);
    itemsEl.classList.toggle('hidden', empty);
    footerEl.classList.toggle('hidden', empty);

    itemsEl.innerHTML = lines
      .map((l) => {
        const media = l.image
          ? `<img src="${escapeHtml(l.image)}" alt="" class="h-full w-full object-cover" />`
          : `<div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blush to-blush-deep p-2 text-center"><span class="font-display text-xs leading-tight text-wine/70">${escapeHtml(l.title)}</span></div>`;
        const size = l.size ? `<span class="text-xs text-ink/55">Size ${escapeHtml(l.size)}</span>` : '';
        return `<li class="flex gap-4 py-4">
          <a href="/product/${encodeURIComponent(l.slug)}" class="h-24 w-20 shrink-0 overflow-hidden rounded-xl bg-blush">${media}</a>
          <div class="flex flex-1 flex-col">
            <a href="/product/${encodeURIComponent(l.slug)}" class="font-display text-lg leading-snug text-ink hover:text-wine">${escapeHtml(l.title)}</a>
            ${size}
            <div class="mt-auto flex items-center justify-between">
              <span class="font-bold text-wine">${money(l.priceCents)}</span>
              <button data-remove="${escapeHtml(l.slug)}" class="text-xs text-ink/50 underline underline-offset-4 transition hover:text-wine">Remove</button>
            </div>
          </div>
        </li>`;
      })
      .join('');

    subtotalEl.textContent = money(cartSubtotalCents());

    const n = lines.length;
    if (n >= MIN) {
      bundleNoteEl.textContent = `Bundle unlocked. ${PCT}% off is applied at checkout.`;
      bundleNoteEl.classList.remove('hidden');
    } else if (n > 0) {
      const more = MIN - n;
      bundleNoteEl.textContent = `Add ${more} more ${more === 1 ? 'piece' : 'pieces'} to get ${PCT}% off your order.`;
      bundleNoteEl.classList.remove('hidden');
    } else {
      bundleNoteEl.classList.add('hidden');
    }

    updateCounts();
  }

  const open = () => {
    if (!drawer || !panel) return;
    render();
    drawer.classList.remove('hidden');
    window.requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    document.body.classList.add('overflow-hidden');
  };

  const close = () => {
    if (!drawer || !panel) return;
    panel.classList.add('translate-x-full');
    window.setTimeout(() => {
      drawer.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }, 300);
  };

  // Header bag buttons open the drawer.
  document.querySelectorAll<HTMLElement>('[data-cart-toggle]').forEach((b) =>
    b.addEventListener('click', open),
  );
  window.addEventListener('cart:open', open);

  drawer?.querySelectorAll<HTMLElement>('[data-cart-close]').forEach((b) =>
    b.addEventListener('click', close),
  );
  drawer?.querySelector('[data-cart-overlay]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) close();
  });

  itemsEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]');
    if (btn?.dataset.remove) {
      removeFromCart(btn.dataset.remove);
      render();
    }
  });

  checkoutBtn?.addEventListener('click', async () => {
    const slugs = getCart().map((l) => l.slug);
    if (!slugs.length || !errorEl) return;
    checkoutBtn.disabled = true;
    const label = checkoutBtn.textContent;
    checkoutBtn.textContent = 'Taking you to checkout...';
    errorEl.classList.add('hidden');
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slugs }),
      });
      const data = await res.json();
      if (res.ok && data.url) {
        window.location.href = data.url;
        return;
      }
      if (res.status === 409 && Array.isArray(data.unavailable)) {
        pruneCart(data.unavailable);
        render();
        throw new Error('Some pieces just sold and were removed from your bag.');
      }
      throw new Error(data.error || 'Something went wrong. Please try again.');
    } catch (err) {
      errorEl.textContent = (err as Error).message;
      errorEl.classList.remove('hidden');
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = label;
    }
  });

  onCartChange(render);
  updateCounts();
</script>
