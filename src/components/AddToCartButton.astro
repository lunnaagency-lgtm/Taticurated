---
import type { Product } from '../lib/types';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const available = product.status === 'available';
const line = {
  slug: product.slug,
  title: product.title,
  priceCents: product.priceCents,
  image: product.images[0]?.url ?? null,
  size: product.size,
};
---

{available ? (
  <button
    data-add-to-cart
    data-line={JSON.stringify(line)}
    type="button"
    class="w-full rounded-lg bg-ink px-6 py-4 text-base font-bold text-ivory transition hover:-translate-y-0.5 hover:bg-brown disabled:cursor-not-allowed disabled:opacity-60"
  >
    Add to bag
  </button>
) : (
  <button
    type="button"
    disabled
    class="w-full cursor-not-allowed rounded-lg bg-paper px-6 py-4 text-base font-bold text-brown"
  >
    {product.status === 'sold' ? 'Sold' : 'On hold'}
  </button>
)}

<script>
  import { addToCart, isInCart } from '../lib/cart';

  document.querySelectorAll<HTMLButtonElement>('button[data-add-to-cart]').forEach((btn) => {
    const line = JSON.parse(btn.dataset.line || '{}');

    const rest = () => {
      btn.textContent = isInCart(line.slug) ? 'In your bag. View' : 'Add to bag';
    };
    rest();

    btn.addEventListener('click', () => {
      const { added, lines } = addToCart(line);
      window.dispatchEvent(new CustomEvent('cart:open'));
      if (added) {
        btn.textContent = 'Added to bag';
        const count = lines.length;
        window.dispatchEvent(new CustomEvent('cart:announce', {
          detail: {
            message: `Added ${line.title} to bag. ${count} ${count === 1 ? 'item' : 'items'} in bag.`,
          },
        }));
        window.setTimeout(rest, 1400);
      }
    });
  });
</script>
